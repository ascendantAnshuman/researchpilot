# =====================================================================
# ResearchPilot configuration
#
# Copy this file to `.env` in the same folder and fill in the values:
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
#
# The real `.env` is git-ignored - never commit it.
# Comments must sit on their own line (Docker does not strip inline comments).
# =====================================================================

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
APP_NAME=ResearchPilot
# development | test | production  (production enforces a strong JWT secret)
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# URL prefix for every API route
API_PREFIX=/api
# Comma-separated list of frontend URLs allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------
# LLM - Anthropic Claude
# ---------------------------------------------------------------------
# Create a key at https://console.anthropic.com/ -> Settings -> API keys
ANTHROPIC_API_KEY=
# Model used by every agent. Price per 1M input / output tokens:
#   claude-opus-5      $5 / $25   (default, strongest reasoning)
#   claude-sonnet-5    $2 / $10   (cheaper; good for long eval runs)
#   claude-haiku-4-5   $1 / $5    (fastest and cheapest)
LLM_MODEL=claude-opus-5
# Reasoning effort: low | medium | high | xhigh | max
# (ignored automatically for models that do not support it, e.g. Haiku 4.5)
LLM_EFFORT=high
# Upper bound on tokens Claude may generate per call (thinking + answer; calls are streamed,
# so a high cap is safe and you only pay for tokens actually generated)
LLM_MAX_TOKENS=32000
LLM_TIMEOUT_SECONDS=300
# Automatic retries (with exponential backoff) on rate limits, overload and network errors
LLM_MAX_RETRIES=5
# Maximum simultaneous Claude requests (keep low on new accounts with small rate limits)
LLM_MAX_CONCURRENCY=3
# If Claude Opus 5 declines a request, let the API re-run it on Anthropic's recommended fallback model
LLM_REFUSAL_FALLBACK=true
# Optional price overrides in USD per 1M tokens, used for cost tracking.
# Leave blank to use the built-in price table for the chosen model.
LLM_INPUT_COST_PER_MTOK=
LLM_OUTPUT_COST_PER_MTOK=

# ---------------------------------------------------------------------
# Auth (JWT)
# ---------------------------------------------------------------------
# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left blank in development, a random secret is used and logins reset on every restart.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# 1440 minutes = 24 hours
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# bcrypt cost factor: each +1 doubles hashing time (12 is about 0.25 s per login on a laptop)
BCRYPT_ROUNDS=12
# Set to false on a public deployment once your own account exists, so strangers
# cannot register and run research on your Anthropic API budget.
ALLOW_REGISTRATION=true

# ---------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------
# Folder for the SQLite database, ChromaDB index and cached PDFs.
# Relative paths are resolved from the backend/ folder.
DATA_DIR=data
# Optional full SQLAlchemy URL. Leave blank to use SQLite inside DATA_DIR.
DATABASE_URL=

# ---------------------------------------------------------------------
# Paper search (arXiv + Semantic Scholar)
# ---------------------------------------------------------------------
# Strongly recommended (free; approval can take a few days):
#   https://www.semanticscholar.org/product/api#api-key-form
# Without a key, requests share one global public quota that is often exhausted (HTTP 429);
# searches then fall back to arXiv only and papers have no citation counts.
SEMANTIC_SCHOLAR_API_KEY=
# Results fetched per sub-query from EACH source
SEARCH_RESULTS_PER_QUERY=10
# Papers kept after de-duplication and ranking
TOP_N_PAPERS=10
# Ranking score = relevance*w1 + citations*w2 + recency*w3
RANK_WEIGHT_RELEVANCE=0.5
RANK_WEIGHT_CITATIONS=0.3
RANK_WEIGHT_RECENCY=0.2
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=4
HTTP_USER_AGENT=ResearchPilot/0.1 (academic research assistant)

# ---------------------------------------------------------------------
# Reader / retrieval (RAG)
# ---------------------------------------------------------------------
# Local, free embedding model (~90 MB, downloaded on first use, runs on CPU)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
# Safety limits so a laptop never chokes on a huge PDF
MAX_PDF_PAGES=40
MAX_PDF_MB=25
# How many PDFs are downloaded/parsed in parallel
READER_CONCURRENCY=3
# Chunks retrieved per query for synthesis, verification and chat
RETRIEVAL_TOP_K=8

# ---------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------
# Set to false to skip the Critic agent (the "without critic" ablation)
ENABLE_CRITIC=true
# Synthesizer revision passes triggered by the Critic
MAX_REVISIONS=1
# Retrieved passages given to the Synthesizer (more = better coverage, higher cost)
MAX_EVIDENCE_CHUNKS=24
# Upper bound on atomic claims the Critic verifies per report
MAX_CLAIMS=40
# What happens to claims still unsupported after the revision: remove | flag
UNSUPPORTED_CLAIM_POLICY=remove

# ---------------------------------------------------------------------
# API limits
# ---------------------------------------------------------------------
# Research runs executing at the same time on the server (extra runs wait in a queue)
MAX_CONCURRENT_RUNS=2
# Unfinished runs one user may have at once
MAX_ACTIVE_RUNS_PER_USER=2
# Previous chat turns sent to Claude with each follow-up question
CHAT_HISTORY_TURNS=6

# ---------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------
# Where the browser reaches the backend. For local dev, also put this line in frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000
